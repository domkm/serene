{:paths ["sources/main" "resources/main"]
 :deps {org.clojure/clojure {:mvn/version "1.12.7"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        fipp/fipp {:mvn/version "0.6.29"}
        http-kit/http-kit {:mvn/version "2.8.1"}}
 :aliases
 {:test {:extra-paths ["sources/test" "resources/test"]
         :extra-deps {com.walmartlabs/lacinia {:mvn/version "1.3.0"}
                      org.clojure/clojurescript {:mvn/version "1.12.145"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}}
  :dev {:extra-paths ["sources/dev"]
        :extra-deps {expound/expound {:mvn/version "0.9.0"}}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
