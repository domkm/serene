{:paths ["sources/main" "resources/main"]
 :deps {org.clojure/clojure {:mvn/version "1.10.0"}
        org.clojure/clojurescript {:mvn/version "1.10.439"}
        org.clojure/data.json {:mvn/version "0.2.6"}
        org.clojure/spec.alpha {:mvn/version "0.2.176"}
        fipp/fipp {:mvn/version "0.6.14"}
        http-kit/http-kit {:mvn/version "2.3.0"}}
 :aliases
 {:test {:extra-paths ["sources/test" "resources/test"]
         :extra-deps {com.walmartlabs/lacinia {:mvn/version "0.31.0"}
                      org.clojure/test.check {:mvn/version "0.10.0-alpha3"}}}
  :dev {:extra-paths ["sources/dev"]
        :extra-deps {expound/expound {:mvn/version "0.7.2"}}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
